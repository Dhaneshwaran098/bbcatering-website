# Copy this file to .env and fill in real values before running the server.
# NEVER commit your real .env file to git or share it publicly.

PORT=3000

# Admin login username
ADMIN_USERNAME=admin

# Generate this by running:  node scripts/hash-password.js "yourChosenPassword"
# Then paste the printed value here (it looks like: 60c0864c...:8dd9f2aa...)
ADMIN_PASSWORD_HASH=

# Any long random string — used to sign session cookies.
# You can generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase Database Configuration
# Found at: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
# Use Service Role Key for server-side access (bypasses RLS for full admin CRUD):
SUPABASE_SERVICE_ROLE_KEY=
# Or use Anon Key:
SUPABASE_ANON_KEY=

# Admin Email (For password reset OTP delivery)
ADMIN_EMAIL=bbcateringsocialmedia@gmail.com

# SMTP Settings for sending OTP emails (Optional in dev mode: OTP is printed to console)
# For Gmail: Use an App Password (Google Account -> Security -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BB Catering" <bbcateringsocialmedia@gmail.com>


