<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Menu & Specialities', description: 'Browse a selection of menu choices for weddings, corporate events and private celebrations, with indicative pricing.' }) %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-header">
  <div class="hero-bg"><div class="ph-photo" style="height:100%;background-image:url('https://images.unsplash.com/photo-1596040033229-a9821ebd058d?auto=format&fit=crop&w=1800&q=80')"></div></div>
  <div class="hero-scrim"></div>
  <div class="container">
    <div class="eyebrow">Menu &amp; Specialities</div>
    <h1>Menus Made for Every Celebration</h1>
    <p class="crumbs"><a href="/">Home</a> / Menu</p>
    <p class="lead">Browse a selection of dishes and use it as a starting point for your own event menu.</p>
  </div>
</section>

<div class="marquee">
  <div class="marquee-track">
    <span class="marquee-item">Wedding Catering</span><span class="marquee-item">Corporate Events</span><span class="marquee-item">Birthday &amp; Private Parties</span><span class="marquee-item">Custom Menus</span><span class="marquee-item">Live Counters</span><span class="marquee-item">Bulk Food Orders</span>
    <span class="marquee-item">Wedding Catering</span><span class="marquee-item">Corporate Events</span><span class="marquee-item">Birthday &amp; Private Parties</span><span class="marquee-item">Custom Menus</span><span class="marquee-item">Live Counters</span><span class="marquee-item">Bulk Food Orders</span>
  </div>
</div>

<section class="section">
  <div class="container">

    <% if (categories.length === 0) { %>
      <p class="text-center" style="color:var(--ink-soft);">The menu is being updated — please check back shortly, or contact us directly.</p>
    <% } else { %>

    <div class="menu-tabs" data-reveal="fade">
      <% categories.forEach((cat, i) => { %>
        <button class="menu-tab <%= i===0 ? 'active' : '' %>" data-target="panel-<%= i %>"><%= cat %></button>
      <% }) %>
    </div>

    <% categories.forEach((cat, i) => { %>
    <div class="menu-panel <%= i===0 ? 'active' : '' %>" id="panel-<%= i %>">
      <div class="grid grid--4" data-stagger>
        <% grouped[cat].forEach(dish => { %>
        <div class="card dish-card" data-reveal="scale">
          <div class="card-media"><div class="ph-photo" style="background-image:url('<%= dish.image %>')"></div></div>
          <div class="card-body">
            <div>
              <h4><%= dish.name %></h4>
              <div class="spice">
                <% for (let s=0;s<4;s++) { %><span class="<%= s < dish.spice ? 'on' : '' %>"></span><% } %>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% }) %>

    <% } %>

    <div class="text-center" style="margin-top:50px;" data-reveal="fade">
      <p style="font-family:var(--font-display); font-style:italic; font-size:19px; color:var(--red); margin-bottom:20px;">Menus can be tailored to your event, guest count and service requirements.</p>
      <a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener" class="btn btn--primary">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.476-.15-.677.15-.201.3-.777.978-.952 1.179-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.497-.896-.799-1.501-1.787-1.677-2.088-.175-.301-.019-.464.132-.614.136-.135.301-.351.451-.527.151-.176.201-.301.302-.502.101-.2.05-.376-.025-.526-.075-.15-.677-1.633-.928-2.235-.245-.587-.494-.507-.677-.517-.176-.01-.376-.01-.577-.01-.201 0-.526.075-.802.376-.276.301-1.053 1.029-1.053 2.511s1.078 2.912 1.229 3.113c.15.2 2.121 3.239 5.139 4.542.718.31 1.279.495 1.716.634.721.229 1.377.197 1.896.119.579-.087 1.78-.727 2.031-1.429.251-.702.251-1.303.176-1.429-.076-.125-.276-.201-.577-.351zM12.04 2c-5.522 0-10 4.477-10 10 0 1.765.459 3.424 1.261 4.871L2 22l5.281-1.385A9.957 9.957 0 0 0 12.04 22c5.522 0 10-4.478 10-10s-4.478-10-10-10zm0 18.273c-1.564 0-3.023-.424-4.283-1.162l-.307-.182-3.178.833.848-3.097-.2-.318A8.232 8.232 0 0 1 3.766 12c0-4.562 3.712-8.273 8.274-8.273 4.562 0 8.273 3.711 8.273 8.273 0 4.562-3.711 8.273-8.273 8.273z"/></svg>
        Discuss Your Order on WhatsApp
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
