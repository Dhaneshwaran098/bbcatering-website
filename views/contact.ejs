<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Contact & Enquiries', description: 'Get in touch for catering enquiries — phone, WhatsApp, address, enquiry form, directions and social media.' }) %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-header">
  <div class="hero-bg"><div class="ph-photo" style="height:100%;background-image:url('https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&w=1800&q=80')"></div></div>
  <div class="hero-scrim"></div>
  <div class="container">
    <div class="eyebrow">Contact &amp; Enquiries</div>
    <h1>Let's Plan Your Celebration</h1>
    <p class="crumbs"><a href="/">Home</a> / Contact</p>
    <p class="lead">Reach out over WhatsApp, call us directly, or visit us at <%= settings.address %> to discuss your catering plans.</p>
  </div>
</section>

<!-- ============ MARQUEE TICKER ============ -->
<div class="marquee">
  <div class="marquee-track">
    <span class="marquee-item">BB Catering</span><span class="marquee-item">Quality &bull; Quantity &bull; Taste &bull; Every Time</span><span class="marquee-item">Authentic Non-Veg Favourites</span><span class="marquee-item">Non-Veg Inspired Veg Dishes</span><span class="marquee-item">Madurai Kurakadai, Mambakkam</span><span class="marquee-item">Wedding &amp; Event Catering</span>
    <span class="marquee-item">BB Catering</span><span class="marquee-item">Quality &bull; Quantity &bull; Taste &bull; Every Time</span><span class="marquee-item">Authentic Non-Veg Favourites</span><span class="marquee-item">Non-Veg Inspired Veg Dishes</span><span class="marquee-item">Madurai Kurakadai, Mambakkam</span><span class="marquee-item">Wedding &amp; Event Catering</span>
  </div>
</div>

<!-- ============ CONTACT INFO CARDS ============ -->
<section class="section--tight">
  <div class="container">
    <div class="info-grid" data-stagger>
      <div class="info-card" data-reveal="fade">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .7 3a2 2 0 0 1-.4 2.1L8 10.3a16 16 0 0 0 6 6l1.5-1.5a2 2 0 0 1 2-.5c1 .3 2 .5 3 .6a2 2 0 0 1 1.5 2Z"/></svg></div>
        <div><h4>Call Us</h4><a href="tel:<%= settings.phone %>"><%= settings.phone %></a><p>Mon - Sun, 9:00 AM - 10:00 PM</p></div>
      </div>
      <div class="info-card" data-reveal="fade">
        <div class="ic" style="background:#25D366;color:#fff;"><svg viewBox="0 0 32 32" width="22" height="22" fill="currentColor"><path d="M16 2a13.9 13.9 0 0 0-12 21L2 30l7.2-1.9A13.9 13.9 0 1 0 16 2zm0 25.5c-2.3 0-4.6-.6-6.6-1.8l-.5-.3-4.9 1.3 1.3-4.7-.3-.5A11.5 11.5 0 1 1 16 27.5z"/><path d="M21.5 18.8c-.3-.2-1.8-.9-2-.9-.3-.1-.5-.2-.7.2s-.8 1-1 1.2c-.2.2-.4.2-.7.1a8.6 8.6 0 0 1-2.6-1.6 9.4 9.4 0 0 1-1.8-2.3c-.2-.3 0-.5.1-.7.1-.1.3-.4.5-.5.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.1 1.1-1.1 2.6 1.1 3 1.3 3.2c.1.2 2.2 3.4 5.3 4.7.7.3 1.3.5 1.8.7.7.2 1.4.2 2 .1.6-.1 1.8-.7 2.1-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.6-.5z"/></svg></div>
        <div><h4>WhatsApp</h4><a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener"><%= settings.phone %></a><p>Instant chat &amp; fast quotes</p></div>
      </div>
      <div class="info-card" data-reveal="fade">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></div>
        <div><h4>Visit Us</h4><a href="<%= settings.mapUrl || '/contact' %>" target="_blank" rel="noopener"><%= settings.address %></a><p style="color:var(--orange);font-weight:600;margin-top:4px;">Meet our catering team</p></div>
      </div>
      <div class="info-card" data-reveal="fade">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></div>
        <div><h4>Email</h4><a href="mailto:<%= settings.email %>"><%= settings.email %></a><p>For orders &amp; queries</p></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FORM + MAP ============ -->
<section class="section">
  <div class="container split" style="align-items:flex-start;">
    <div data-reveal="left">
      <div class="eyebrow">Send an Enquiry</div>
      <h2>Tell Us About Your Event</h2>
      <p style="margin-top:14px; color:var(--ink-soft);">Fill in the details below — on submitting, we'll open WhatsApp with your enquiry ready to send to our team.</p>

      <div class="form-success" style="margin-top:24px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>
        Thanks! Opening WhatsApp with your enquiry details now.
      </div>

      <form id="enquiry-form" data-whatsapp="<%= settings.whatsapp %>" style="margin-top:16px;">
        <div class="form-grid">
          <div class="field"><label for="name">Full Name</label><input type="text" id="name" name="name" placeholder="Your name" required></div>
          <div class="field"><label for="phone">Phone Number</label><input type="tel" id="phone" name="phone" placeholder="+91 98765 43210" pattern="[0-9+\s\-]{10,15}" title="Please enter a valid phone number (at least 10 digits)" required></div>
          <div class="field">
            <label for="event-type">Event Type</label>
            <select id="event-type" name="event-type">
              <option>Wedding Catering</option>
              <option>Engagement / Family Function</option>
              <option>Birthday / Private Event</option>
              <option>Corporate Event</option>
              <option>Traditional / Cultural Function</option>
              <option>Menu Consultation</option>
              <option>Bulk Food Order</option>
            </select>
          </div>
          <div class="field"><label for="guests">Approx. Guest Count</label><input type="number" id="guests" name="guests" placeholder="e.g. 200" min="1"></div>
          <div class="field full"><label for="date">Preferred Date</label><input type="date" id="date" name="date"></div>
          <div class="field full"><label for="message">Your Message</label><textarea id="message" name="message" placeholder="Tell us more about your event, menu preferences, or if you'd like a tasting session..."></textarea></div>
        </div>
        <button type="submit" class="btn btn--primary btn--block" style="margin-top:22px;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.476-.15-.677.15-.201.3-.777.978-.952 1.179-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.497-.896-.799-1.501-1.787-1.677-2.088-.175-.301-.019-.464.132-.614.136-.135.301-.351.451-.527.151-.176.201-.301.302-.502.101-.2.05-.376-.025-.526-.075-.15-.677-1.633-.928-2.235-.245-.587-.494-.507-.677-.517-.176-.01-.376-.01-.577-.01-.201 0-.526.075-.802.376-.276.301-1.053 1.029-1.053 2.511s1.078 2.912 1.229 3.113c.15.2 2.121 3.239 5.139 4.542.718.31 1.279.495 1.716.634.721.229 1.377.197 1.896.119.579-.087 1.78-.727 2.031-1.429.251-.702.251-1.303.176-1.429-.076-.125-.276-.201-.577-.351zM12.04 2c-5.522 0-10 4.477-10 10 0 1.765.459 3.424 1.261 4.871L2 22l5.281-1.385A9.957 9.957 0 0 0 12.04 22c5.522 0 10-4.478 10-10s-4.478-10-10-10zm0 18.273c-1.564 0-3.023-.424-4.283-1.162l-.307-.182-3.178.833.848-3.097-.2-.318A8.232 8.232 0 0 1 3.766 12c0-4.562 3.712-8.273 8.274-8.273 4.562 0 8.273 3.711 8.273 8.273 0 4.562-3.711 8.273-8.273 8.273z"/></svg>
          Send Enquiry via WhatsApp
        </button>
        <p class="form-note">We typically respond within a few hours. For urgent enquiries, please call us directly.</p>
      </form>
    </div>

    <div data-reveal="right">
      <div class="map-frame">
        <iframe src="<%= settings.mapEmbedUrl %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Location"></iframe>
      </div>
      <a href="<%= settings.mapUrl || ('https://maps.google.com/?q=' + encodeURIComponent(settings.address)) %>" target="_blank" rel="noopener" class="btn btn--dark-outline btn--block" style="margin-top:20px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        Get Directions
      </a>
      <div style="margin-top:26px;">
        <h4 style="font-size:15px; color:var(--brown); margin-bottom:14px;">Follow Us</h4>
        <div class="social-row">
          <a href="<%= settings.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
          <a href="<%= settings.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 9h3V6h-3a3 3 0 0 0-3 3v2H8v3h3v6h3v-6h3l1-3h-4V9a1 1 0 0 1 1-1Z"/></svg></a>
          <a href="<%= settings.youtube %>" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="6" width="20" height="12" rx="3"/><path d="m10 9 5 3-5 3V9Z"/></svg></a>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="divider-strip"><div class="kolam-divider" style="width:220px;"></div></div>

<!-- ============ FAQ ============ -->
<section class="section">
  <div class="container">
    <div class="section-head center" data-reveal="fade">
      <div class="eyebrow">Common Questions</div>
      <h2>Frequently Asked Questions</h2>
      <p>A few things clients usually ask before booking. Still curious? Just send us a message.</p>
    </div>
    <div class="faq" data-reveal="fade">
      <div class="faq-item"><button class="faq-q"><span>How far in advance should I book catering?</span><span class="plus"></span></button><div class="faq-a"><p>For weddings and large functions, we recommend booking at least 3-4 weeks ahead. For birthdays or smaller private events, 1-2 weeks is usually enough. During peak wedding season, earlier is always better.</p></div></div>
      <div class="faq-item"><button class="faq-q"><span>What is the minimum guest count for an order?</span><span class="plus"></span></button><div class="faq-a"><p>We cater everything from an intimate 30-guest family lunch to weddings with 2,000+ guests. Bulk parcel orders can be arranged for even smaller quantities — just ask us on WhatsApp.</p></div></div>
      <div class="faq-item"><button class="faq-q"><span>Do you provide serving staff and equipment?</span><span class="plus"></span></button><div class="faq-a"><p>Yes. Depending on your package, we can provide serving staff, live counters, chafing dishes and basic buffet setup. Let us know your venue details and we'll recommend what's needed.</p></div></div>
      <div class="faq-item"><button class="faq-q"><span>Can you customise the menu for our event?</span><span class="plus"></span></button><div class="faq-a"><p>Absolutely — our menu is a starting point. We regularly adjust spice levels, portion sizes and dish combinations to match your guests' preferences and budget.</p></div></div>
      <div class="faq-item"><button class="faq-q"><span>How is pricing calculated?</span><span class="plus"></span></button><div class="faq-a"><p>Pricing depends on guest count, menu selection and service level (drop-off, buffet, or full-service with staff). Share your event details with us on WhatsApp or the form above for an exact quote.</p></div></div>
    </div>
  </div>
</section>

<div class="divider-strip"><div class="kolam-divider" style="width:220px;"></div></div>

<!-- ============ QR SECTION ============ -->
<section class="section--tight">
  <div class="container">
    <div class="qr-block" data-reveal="scale">
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=240x240&color=7A1F1F&bgcolor=FFF4E3&data=<%= encodeURIComponent(settings.mapUrl || ('https://maps.google.com/?q=' + encodeURIComponent(settings.address))) %>" alt="QR code linking to BB Catering location">
      <div>
        <h4>Scan to Connect With Us</h4>
        <p>Scan this code with your phone camera to instantly open our location, chat on WhatsApp or call our catering desk.</p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
