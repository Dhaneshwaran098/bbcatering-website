<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Verify OTP & Reset Password | BB Catering Admin</title>
<link rel="stylesheet" href="/css/style.css">
<style>
  .admin-success-msg {
    background: #ecfdf5;
    border: 1px solid #10b981;
    color: #065f46;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    font-size: 13.5px;
    margin-top: 18px;
    line-height: 1.5;
  }
  .otp-input {
    font-family: monospace;
    font-size: 24px !important;
    letter-spacing: 6px;
    text-align: center;
    font-weight: 700;
  }
  .back-link {
    display: block;
    text-align: center;
    margin-top: 18px;
    font-size: 13.5px;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
  }
  .back-link:hover {
    color: var(--red);
  }
  .resend-row {
    text-align: center;
    font-size: 12.5px;
    color: var(--ink-soft);
    margin-top: 6px;
  }
  .resend-row a {
    color: var(--gold-deep);
    font-weight: 600;
    text-decoration: none;
  }
  .resend-row a:hover {
    text-decoration: underline;
  }
</style>
</head>
<body class="admin-body">
  <div class="admin-login-wrap">
    <div class="admin-login-card">
      <div class="brand-mark" style="width:72px;height:72px;background:transparent;border:none;padding:2px;">
        <img src="/images/logo.png" alt="BB Catering" style="width:100%;height:100%;object-fit:contain;">
      </div>
      <h1>Verify OTP Code</h1>
      <p class="sub">Enter the 6-digit verification code sent to your email and pick a new secure password.</p>

      <% if (locals.msg) { %>
        <div class="admin-success-msg"><%= msg %></div>
      <% } %>

      <% if (locals.error) { %>
        <div class="admin-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/reset-password">
        <div class="admin-field">
          <label for="identifier">Username or Email</label>
          <input 
            type="text" 
            id="identifier" 
            name="identifier" 
            value="<%= locals.identifier || '' %>" 
            placeholder="admin or email" 
            required
          >
        </div>

        <div class="admin-field">
          <label for="otp">6-Digit Verification Code (OTP)</label>
          <input 
            type="text" 
            id="otp" 
            name="otp" 
            class="otp-input" 
            placeholder="••••••" 
            maxlength="6" 
            pattern="[0-9]{6}" 
            required 
            autofocus
          >
        </div>

        <div class="admin-field">
          <label for="password">New Password</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            placeholder="At least 6 characters" 
            minlength="6" 
            required
          >
        </div>

        <div class="admin-field">
          <label for="confirmPassword">Confirm New Password</label>
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            placeholder="Re-enter password" 
            minlength="6" 
            required
          >
        </div>

        <button type="submit" class="admin-btn--primary" style="margin-top:8px;">
          Reset Password &rarr;
        </button>

        <div class="resend-row">
          Didn't receive code? <a href="/admin/forgot-password">Resend OTP</a>
        </div>
      </form>

      <a href="/admin/login" class="back-link">&larr; Back to Admin Login</a>
    </div>
  </div>
</body>
</html>
