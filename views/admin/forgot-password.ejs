<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Forgot Password | BB Catering Admin</title>
<link rel="stylesheet" href="/css/style.css">
<style>
  .admin-success-msg {
    background: #ecfdf5;
    border: 1px solid #10b981;
    color: #065f46;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    font-size: 13.5px;
    margin-top: 18px;
    line-height: 1.5;
  }
  .back-link {
    display: block;
    text-align: center;
    margin-top: 22px;
    font-size: 13.5px;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
  }
  .back-link:hover {
    color: var(--red);
  }
</style>
</head>
<body class="admin-body">
  <div class="admin-login-wrap">
    <div class="admin-login-card">
      <div class="brand-mark" style="width:72px;height:72px;background:transparent;border:none;padding:2px;">
        <img src="/images/logo.png" alt="BB Catering" style="width:100%;height:100%;object-fit:contain;">
      </div>
      <h1>Reset Password</h1>
      <p class="sub">Enter your admin username or registered email address. We'll send a 6-digit OTP code to verify your identity.</p>

      <% if (locals.msg) { %>
        <div class="admin-success-msg"><%= msg %></div>
      <% } %>

      <% if (locals.error) { %>
        <div class="admin-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/forgot-password">
        <div class="admin-field">
          <label for="identifier">Username or Email</label>
          <input 
            type="text" 
            id="identifier" 
            name="identifier" 
            placeholder="admin or bbcateringsocialmedia@gmail.com" 
            required 
            autofocus
          >
        </div>
        <button type="submit" class="admin-btn--primary" style="margin-top:8px;">
          Send OTP Code &rarr;
        </button>
      </form>

      <a href="/admin/login" class="back-link">&larr; Back to Admin Login</a>
    </div>
  </div>
</body>
</html>
