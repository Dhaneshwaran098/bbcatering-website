<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Enquiries &amp; Leads | Admin</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/adminNav', { active: 'enquiries' }) %>
  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h1>Customer Enquiries &amp; Leads</h1>
        <p>Live incoming inquiries and event bookings submitted from your website.</p>
      </div>
    </div>

    <% if (msg) { %><div class="admin-flash"><%= msg %></div><% } %>

    <div class="stat-cards">
      <div class="stat-card">
        <b><%= counts.total %></b>
        <span>Total Enquiries</span>
      </div>
      <div class="stat-card">
        <b style="color:var(--orange);"><%= counts.new %></b>
        <span>New / Unhandled</span>
      </div>
      <div class="stat-card">
        <b style="color:#2563eb;"><%= counts.contacted %></b>
        <span>Contacted</span>
      </div>
      <div class="stat-card">
        <b style="color:#16a34a;"><%= counts.booked %></b>
        <span>Confirmed Bookings</span>
      </div>
    </div>

    <div class="admin-card">
      <div class="enq-filter-tabs">
        <a href="/admin/enquiries" class="enq-tab-btn <%= !filter || filter==='all' ? 'active' : '' %>">
          All Leads (<%= counts.total %>)
        </a>
        <a href="/admin/enquiries?status=new" class="enq-tab-btn <%= filter==='new' ? 'active' : '' %>">
          New (<%= counts.new %>)
        </a>
        <a href="/admin/enquiries?status=contacted" class="enq-tab-btn <%= filter==='contacted' ? 'active' : '' %>">
          Contacted (<%= counts.contacted %>)
        </a>
        <a href="/admin/enquiries?status=booked" class="enq-tab-btn <%= filter==='booked' ? 'active' : '' %>">
          Booked (<%= counts.booked %>)
        </a>
        <a href="/admin/enquiries?status=cancelled" class="enq-tab-btn <%= filter==='cancelled' ? 'active' : '' %>">
          Cancelled (<%= counts.cancelled %>)
        </a>
      </div>

      <% if (enquiries.length === 0) { %>
        <div style="text-align:center; padding:50px 20px;">
          <div style="font-size:44px; margin-bottom:12px;">📬</div>
          <h3 style="font-size:18px; color:var(--brown); margin-bottom:6px;">No enquiries found in this category</h3>
          <p style="color:var(--ink-soft); font-size:14px; max-width:400px; margin:0 auto;">When customers submit the enquiry form on your website, their contact details and event requests will appear here.</p>
        </div>
      <% } else { %>
      <div style="overflow-x:auto;">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Date / Status</th>
              <th>Customer</th>
              <th>Event Details</th>
              <th>Message / Notes</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% enquiries.forEach(enq => { 
               const d = enq.createdAt ? new Date(enq.createdAt) : new Date();
               const dateStr = d.toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });
               const timeStr = d.toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' });
               const cleanPhone = (enq.phone || '').replace(/\D/g, '');
               const waPhone = cleanPhone.length === 10 ? '91' + cleanPhone : cleanPhone;
            %>
            <tr>
              <td>
                <span class="lead-status <%= enq.status %>"><%= enq.status %></span>
                <div style="font-size:12.5px; color:var(--ink-soft); margin-top:6px; font-weight:600;"><%= dateStr %></div>
                <div style="font-size:11.5px; color:var(--ink-soft);"><%= timeStr %></div>
              </td>
              <td>
                <strong style="font-size:15px; color:var(--ink);"><%= enq.name %></strong>
                <div style="font-size:13.5px; color:var(--brown); font-weight:700; margin-top:2px;"><%= enq.phone %></div>
                <div class="lead-contact-links">
                  <a href="tel:<%= enq.phone %>" class="lead-btn-tel" title="Call Customer">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .7 3a2 2 0 0 1-.4 2.1L8 10.3a16 16 0 0 0 6 6l1.5-1.5a2 2 0 0 1 2-.5c1 .3 2 .5 3 .6a2 2 0 0 1 1.5 2Z"/></svg>
                    Call
                  </a>
                  <a href="https://wa.me/<%= waPhone %>?text=<%= encodeURIComponent(`Hi ${enq.name}, thank you for contacting BB Catering regarding your ${enq.eventType || 'catering'} enquiry!`) %>" target="_blank" rel="noopener" class="lead-btn-wa" title="Open WhatsApp Chat">
                    <svg width="12" height="12" viewBox="0 0 32 32" fill="currentColor"><path d="M16 2a13.9 13.9 0 0 0-12 21L2 30l7.2-1.9A13.9 13.9 0 1 0 16 2zm0 25.5c-2.3 0-4.6-.6-6.6-1.8l-.5-.3-4.9 1.3 1.3-4.7-.3-.5A11.5 11.5 0 1 1 16 27.5z"/></svg>
                    WhatsApp
                  </a>
                </div>
              </td>
              <td>
                <div style="font-weight:700; color:var(--brown); font-size:14px;"><%= enq.eventType || 'Catering Enquiry' %></div>
                <% if (enq.date) { %>
                  <div style="font-size:12.5px; color:var(--ink); margin-top:4px;">📅 Date: <b><%= enq.date %></b></div>
                <% } %>
                <% if (enq.guests) { %>
                  <div style="font-size:12.5px; color:var(--ink); margin-top:2px;">👥 Guests: <b><%= enq.guests %></b></div>
                <% } %>
              </td>
              <td>
                <% if (enq.message) { %>
                  <div class="lead-note-box"><%= enq.message %></div>
                <% } else { %>
                  <span style="color:var(--ink-soft); font-size:12.5px; font-style:italic;">No extra notes provided</span>
                <% } %>
              </td>
              <td>
                <form method="POST" action="/admin/enquiries/<%= enq.id %>/status" style="display:inline-block;">
                  <select name="status" class="lead-status-select" onchange="this.form.submit()">
                    <option value="new" <%= enq.status==='new' ? 'selected' : '' %>>New</option>
                    <option value="contacted" <%= enq.status==='contacted' ? 'selected' : '' %>>Contacted</option>
                    <option value="booked" <%= enq.status==='booked' ? 'selected' : '' %>>Booked</option>
                    <option value="cancelled" <%= enq.status==='cancelled' ? 'selected' : '' %>>Cancelled</option>
                  </select>
                </form>
              </td>
              <td>
                <form method="POST" action="/admin/enquiries/<%= enq.id %>/delete" onsubmit="return confirm('Delete this enquiry permanently?');" style="display:inline;">
                  <button type="submit" class="admin-btn admin-btn--delete" title="Delete enquiry">Delete</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
