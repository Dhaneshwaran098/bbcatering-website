<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard | Admin</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/adminNav', { active: 'dashboard' }) %>
  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h1>Welcome back</h1>
        <p>Manage your menu, gallery photos and site details from here.</p>
      </div>
    </div>

    <% if (msg) { %><div class="admin-flash"><%= msg %></div><% } %>

    <div class="stat-cards">
      <div class="stat-card" style="border-color: rgba(217, 108, 44, 0.4);">
        <b style="color:var(--gold);"><%= enquiryCount %></b>
        <span>Total Enquiries <% if (newEnquiryCount > 0) { %><strong style="color:#f97316;">(<%= newEnquiryCount %> new)</strong><% } %></span>
      </div>
      <div class="stat-card"><b><%= dishCount %></b><span>Dishes on the menu</span></div>
      <div class="stat-card"><b><%= galleryCount %></b><span>Gallery photos</span></div>
      <div class="stat-card"><b><%= categoryCount %></b><span>Menu categories</span></div>
    </div>

    <div class="admin-quick-links">
      <a href="/admin/enquiries" style="border-color: rgba(217, 108, 44, 0.35);">
        <div class="ic" style="background:rgba(217, 108, 44, 0.15); color:var(--orange);">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <h3>Customer Enquiries &amp; Leads</h3>
        <p>View incoming bookings, guest counts, requested dates and client contacts.</p>
      </a>
      <a href="/admin/menu">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6h16M4 12h16M4 18h10"/></svg></div>
        <h3>Manage Menu &amp; Prices</h3>
        <p>Add new dishes, update prices, or remove items from any category.</p>
      </a>
      <a href="/admin/gallery">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="9" r="1.8"/><path d="m21 15-5-5-9 9"/></svg></div>
        <h3>Upload Gallery Photos</h3>
        <p>Add new photos of dishes, events and setups to the public gallery.</p>
      </a>
      <a href="/admin/settings">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="3"/><path d="M12 3v3m0 12v3m9-9h-3M6 12H3m14.5-6.5-2 2M8.5 8.5l-2-2m0 11 2-2m6.5 2 2-2"/></svg></div>
        <h3>Edit Site Settings</h3>
        <p>Update your phone, WhatsApp number, address, socials and hero photo.</p>
      </a>
    </div>

    <% if (recentEnquiries && recentEnquiries.length > 0) { %>
    <div class="admin-card" style="margin-top:28px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h2 style="margin:0;">Recent Enquiries</h2>
        <a href="/admin/enquiries" class="btn btn--dark-outline btn--sm">View All (<%= enquiryCount %>) &rarr;</a>
      </div>
      <table class="admin-table">
        <thead><tr><th>Date</th><th>Customer</th><th>Event</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
          <% recentEnquiries.forEach(enq => { 
             const d = enq.createdAt ? new Date(enq.createdAt) : new Date();
             const dateStr = d.toLocaleDateString('en-IN', { day:'numeric', month:'short' });
             const cleanPhone = (enq.phone || '').replace(/\D/g, '');
             const waPhone = cleanPhone.length === 10 ? '91' + cleanPhone : cleanPhone;
          %>
          <tr>
            <td style="font-size:13px; color:var(--ink-soft);"><%= dateStr %></td>
            <td>
              <strong style="color:var(--ink);"><%= enq.name %></strong>
              <div style="font-size:13px; color:var(--brown); font-weight:700;"><%= enq.phone %></div>
            </td>
            <td>
              <div style="font-size:13.5px; font-weight:600; color:var(--ink);"><%= enq.eventType %></div>
              <% if (enq.date) { %><span style="font-size:12px; color:var(--ink-soft);">📅 <%= enq.date %></span><% } %>
            </td>
            <td>
              <span class="lead-status <%= enq.status %>"><%= enq.status %></span>
            </td>
            <td>
              <a href="https://wa.me/<%= waPhone %>" target="_blank" rel="noopener" class="lead-btn-wa">WhatsApp</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

  </main>
</div>
</body>
</html>
