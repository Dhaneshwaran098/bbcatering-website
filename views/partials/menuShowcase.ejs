<!-- =========================================================
     BB CATERING — CELEBRATION MENU SHOWCASE (VEG & NON-VEG TOGGLE)
     ========================================================= -->
<%
  const allMenus = menus || [];
  const nonVegMenus = allMenus.filter(m => m.type !== 'Vegetarian');
  const vegMenus = allMenus.filter(m => m.type === 'Vegetarian');
%>

<div class="gjm-menu-root" id="celebration-menus">

  <!-- =========================================================
       MASTER CATEGORY TOGGLE BAR (VEG vs NON-VEG)
       ========================================================= -->
  <div class="gjm-cat-switcher-strip">
    <div class="container">
      <div class="gjm-cat-switcher-wrapper">
        <div class="gjm-switcher-prompt">
          <span class="prompt-badge">Choose Menu Type</span>
          <span class="prompt-text">Select a category to view menus:</span>
        </div>
        <div class="gjm-cat-switcher" role="tablist" aria-label="Celebration Menu Category Filter">
          <button 
            type="button" 
            class="gjm-cat-toggle-btn non-veg active" 
            id="btn-cat-non-veg" 
            role="tab" 
            aria-selected="true" 
            aria-controls="cat-section-non-veg"
            data-target="cat-section-non-veg"
          >
            <span class="food-symbol non-veg-symbol" aria-hidden="true"><span class="dot"></span></span>
            <span class="toggle-text">Non-Vegetarian Menus</span>
            <span class="toggle-count"><%= nonVegMenus.length %> Menus</span>
          </button>
          
          <button 
            type="button" 
            class="gjm-cat-toggle-btn veg" 
            id="btn-cat-veg" 
            role="tab" 
            aria-selected="false" 
            aria-controls="cat-section-veg"
            data-target="cat-section-veg"
          >
            <span class="food-symbol veg-symbol" aria-hidden="true"><span class="dot"></span></span>
            <span class="toggle-text">Pure Vegetarian Menus</span>
            <span class="toggle-count"><%= vegMenus.length %> Menus</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       CATEGORY 1: NON-VEGETARIAN CELEBRATION MENUS
       ========================================================= -->
  <section class="gjm-menu-section gjm-non-veg-section gjm-category-content active" id="cat-section-non-veg" role="tabpanel" aria-labelledby="btn-cat-non-veg">
    <div class="container">
      
      <!-- Section Header -->
      <div class="gjm-menu-header" data-reveal="fade">
        <div class="eyebrow eyebrow--non-veg">
          <span class="food-symbol non-veg-symbol" aria-hidden="true"><span class="dot"></span></span>
          <span>Signature Non-Veg Feasts</span>
        </div>
        <h2>Non-Vegetarian Celebration Menus</h2>
        <p>Explore our signature multi-course catering spreads featuring authentic mutton dum biryani, flavorful chicken specialties, fresh coastal seafood, and time-honored South Indian gravies.</p>
      </div>

      <% if (nonVegMenus && nonVegMenus.length > 0) { %>

        <!-- Desktop / Tablet Tabs -->
        <div class="gjm-tabs-container" data-reveal="fade">
          <div class="gjm-tabs-wrapper gjm-tabs-wrapper--non-veg" role="tablist" aria-label="Non-Vegetarian Menus">
            <% nonVegMenus.forEach((m, idx) => { %>
              <button 
                class="gjm-tab-btn gjm-tab-btn--non-veg <%= idx === 0 ? 'active' : '' %>" 
                role="tab" 
                aria-selected="<%= idx === 0 ? 'true' : 'false' %>"
                aria-controls="gjm-non-veg-panel-<%= idx %>"
                id="gjm-non-veg-tab-<%= idx %>"
                data-target="gjm-non-veg-panel-<%= idx %>"
              >
                <span class="tab-title"><%= m.title %></span>
                <% if (m.name) { %><span class="tab-name"><%= m.name %></span><% } %>
              </button>
            <% }) %>
          </div>
        </div>

        <!-- Desktop / Tablet Menu Board Panels -->
        <div class="gjm-board-wrapper" data-reveal="scale">
          <% nonVegMenus.forEach((m, idx) => { 
               const half = Math.ceil(m.items.length / 2);
               const col1 = m.items.slice(0, half);
               const col2 = m.items.slice(half);
          %>
            <div 
              class="gjm-menu-panel gjm-non-veg-panel <%= idx === 0 ? 'active' : '' %>" 
              id="gjm-non-veg-panel-<%= idx %>"
              role="tabpanel"
              aria-labelledby="gjm-non-veg-tab-<%= idx %>"
            >
              <div class="gjm-menu-board gjm-board--non-veg">
                
                <!-- Board Header -->
                <div class="gjm-board-header">
                  <div class="left-info">
                    <span class="food-symbol non-veg-symbol" aria-hidden="true"><span class="dot"></span></span>
                    <span class="gjm-board-title"><%= m.title %></span>
                    <% if (m.name) { %>
                      <span class="gjm-board-subtitle">— <%= m.name %></span>
                    <% } %>
                  </div>
                  <div>
                    <span class="gjm-badge-tag non-veg">
                      <%= m.badge || 'Non-Vegetarian' %>
                    </span>
                  </div>
                </div>

                <!-- Board Grid: Numbered Items (2 cols) + Image (right) -->
                <div class="gjm-board-grid">
                  <div class="gjm-items-grid">
                    <!-- Column 1 -->
                    <div class="gjm-col">
                      <% col1.forEach((item, i) => { %>
                        <div class="gjm-item">
                          <span class="gjm-item-number"><%= i + 1 %>.</span>
                          <span class="gjm-item-text"><%= item %></span>
                        </div>
                      <% }) %>
                    </div>

                    <!-- Column 2 -->
                    <div class="gjm-col">
                      <% col2.forEach((item, i) => { %>
                        <div class="gjm-item">
                          <span class="gjm-item-number"><%= half + i + 1 %>.</span>
                          <span class="gjm-item-text"><%= item %></span>
                        </div>
                      <% }) %>
                    </div>
                  </div>

                  <!-- Featured Dish Image -->
                  <div class="gjm-image-wrap">
                    <div class="gjm-image-card">
                      <img src="<%= m.image %>" alt="<%= m.title %> - <%= m.name %>" loading="lazy">
                      <div class="gjm-image-overlay">
                        <span><%= m.name || m.title %></span>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          <% }) %>
        </div>

        <!-- Mobile Accordion View -->
        <div class="gjm-mobile-accordion gjm-mobile-accordion--non-veg">
          <% nonVegMenus.forEach((m, idx) => { %>
            <div class="gjm-acc-item">
              <button 
                class="gjm-acc-header gjm-acc-header--non-veg <%= idx === 0 ? 'active' : '' %>"
                data-acc-target="gjm-non-veg-acc-body-<%= idx %>"
                aria-expanded="<%= idx === 0 ? 'true' : 'false' %>"
              >
                <div class="gjm-acc-title-wrap">
                  <span class="food-symbol non-veg-symbol" aria-hidden="true"><span class="dot"></span></span>
                  <span><%= m.title %> <% if (m.name) { %><small style="font-weight:400;color:#9ca3af;text-transform:none;"> — <%= m.name %></small><% } %></span>
                </div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="gjm-acc-body <%= idx === 0 ? 'open' : '' %>" id="gjm-non-veg-acc-body-<%= idx %>">
                <ol class="gjm-acc-list">
                  <% m.items.forEach((item, i) => { %>
                    <li><b><%= i + 1 %>.</b> <span><%= item %></span></li>
                  <% }) %>
                </ol>
                <div class="gjm-acc-image">
                  <img src="<%= m.image %>" alt="<%= m.title %>" loading="lazy">
                </div>
              </div>
            </div>
          <% }) %>
        </div>

      <% } %>

    </div>
  </section>

  <!-- =========================================================
       CATEGORY 2: PURE VEGETARIAN CELEBRATION MENUS
       ========================================================= -->
  <section class="gjm-menu-section gjm-veg-section gjm-category-content" id="cat-section-veg" role="tabpanel" aria-labelledby="btn-cat-veg" style="display:none;">
    <div class="container">
      
      <!-- Section Header -->
      <div class="gjm-menu-header" data-reveal="fade">
        <div class="eyebrow eyebrow--veg">
          <span class="food-symbol veg-symbol" aria-hidden="true"><span class="dot"></span></span>
          <span>100% Pure Vegetarian Feasts</span>
        </div>
        <h2>Pure Vegetarian Celebration Menus</h2>
        <p>Authentic South Indian wedding elai sapadu, traditional festive banquets, and gourmet vegetarian spreads prepared with sacred hygiene, fresh farm vegetables, and aromatic spices.</p>
      </div>

      <% if (vegMenus && vegMenus.length > 0) { %>

        <!-- Desktop / Tablet Tabs -->
        <div class="gjm-tabs-container" data-reveal="fade">
          <div class="gjm-tabs-wrapper gjm-tabs-wrapper--veg" role="tablist" aria-label="Pure Vegetarian Menus">
            <% vegMenus.forEach((m, idx) => { %>
              <button 
                class="gjm-tab-btn gjm-tab-btn--veg <%= idx === 0 ? 'active' : '' %>" 
                role="tab" 
                aria-selected="<%= idx === 0 ? 'true' : 'false' %>"
                aria-controls="gjm-veg-panel-<%= idx %>"
                id="gjm-veg-tab-<%= idx %>"
                data-target="gjm-veg-panel-<%= idx %>"
              >
                <span class="tab-title"><%= m.title %></span>
                <% if (m.name) { %><span class="tab-name"><%= m.name %></span><% } %>
              </button>
            <% }) %>
          </div>
        </div>

        <!-- Desktop / Tablet Menu Board Panels -->
        <div class="gjm-board-wrapper" data-reveal="scale">
          <% vegMenus.forEach((m, idx) => { 
               const half = Math.ceil(m.items.length / 2);
               const col1 = m.items.slice(0, half);
               const col2 = m.items.slice(half);
          %>
            <div 
              class="gjm-menu-panel gjm-veg-panel <%= idx === 0 ? 'active' : '' %>" 
              id="gjm-veg-panel-<%= idx %>"
              role="tabpanel"
              aria-labelledby="gjm-veg-tab-<%= idx %>"
            >
              <div class="gjm-menu-board gjm-board--veg">
                
                <!-- Board Header -->
                <div class="gjm-board-header gjm-board-header--veg">
                  <div class="left-info">
                    <span class="food-symbol veg-symbol" aria-hidden="true"><span class="dot"></span></span>
                    <span class="gjm-board-title gjm-board-title--veg"><%= m.title %></span>
                    <% if (m.name) { %>
                      <span class="gjm-board-subtitle">— <%= m.name %></span>
                    <% } %>
                  </div>
                  <div>
                    <span class="gjm-badge-tag veg">
                      <%= m.badge || 'Pure Vegetarian' %>
                    </span>
                  </div>
                </div>

                <!-- Board Grid: Numbered Items (2 cols) + Image (right) -->
                <div class="gjm-board-grid">
                  <div class="gjm-items-grid">
                    <!-- Column 1 -->
                    <div class="gjm-col">
                      <% col1.forEach((item, i) => { %>
                        <div class="gjm-item gjm-item--veg">
                          <span class="gjm-item-number"><%= i + 1 %>.</span>
                          <span class="gjm-item-text"><%= item %></span>
                        </div>
                      <% }) %>
                    </div>

                    <!-- Column 2 -->
                    <div class="gjm-col">
                      <% col2.forEach((item, i) => { %>
                        <div class="gjm-item gjm-item--veg">
                          <span class="gjm-item-number"><%= half + i + 1 %>.</span>
                          <span class="gjm-item-text"><%= item %></span>
                        </div>
                      <% }) %>
                    </div>
                  </div>

                  <!-- Featured Dish Image -->
                  <div class="gjm-image-wrap">
                    <div class="gjm-image-card gjm-image-card--veg">
                      <img src="<%= m.image %>" alt="<%= m.title %> - <%= m.name %>" loading="lazy">
                      <div class="gjm-image-overlay">
                        <span><%= m.name || m.title %></span>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          <% }) %>
        </div>

        <!-- Mobile Accordion View -->
        <div class="gjm-mobile-accordion gjm-mobile-accordion--veg">
          <% vegMenus.forEach((m, idx) => { %>
            <div class="gjm-acc-item">
              <button 
                class="gjm-acc-header gjm-acc-header--veg <%= idx === 0 ? 'active' : '' %>"
                data-acc-target="gjm-veg-acc-body-<%= idx %>"
                aria-expanded="<%= idx === 0 ? 'true' : 'false' %>"
              >
                <div class="gjm-acc-title-wrap">
                  <span class="food-symbol veg-symbol" aria-hidden="true"><span class="dot"></span></span>
                  <span><%= m.title %> <% if (m.name) { %><small style="font-weight:400;color:#86efac;text-transform:none;"> — <%= m.name %></small><% } %></span>
                </div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="gjm-acc-body <%= idx === 0 ? 'open' : '' %>" id="gjm-veg-acc-body-<%= idx %>">
                <ol class="gjm-acc-list">
                  <% m.items.forEach((item, i) => { %>
                    <li><b><%= i + 1 %>.</b> <span><%= item %></span></li>
                  <% }) %>
                </ol>
                <div class="gjm-acc-image gjm-acc-image--veg">
                  <img src="<%= m.image %>" alt="<%= m.title %>" loading="lazy">
                </div>
              </div>
            </div>
          <% }) %>
        </div>

      <% } %>

    </div>
  </section>

  <!-- =========================================================
       CUSTOM MENU WHATSAPP BANNER (ALWAYS VISIBLE)
       ========================================================= -->
  <div class="gjm-custom-banner-section">
    <div class="container">
      <div class="gjm-custom-banner" data-reveal="fade">
        <div class="gjm-banner-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
            <path d="M20 3v4"/>
            <path d="M22 5h-4"/>
            <path d="M4 17v2"/>
            <path d="M5 18H3"/>
          </svg>
        </div>
        <h3>Your Menu, Your Style</h3>
        <p>We customize both Veg and Non-Veg menus completely to your taste. Choose your favorites and create the perfect combo—just the way you want.</p>
        <div class="gjm-banner-actions">
          <a href="https://wa.me/<%= settings.whatsapp %>?text=Hi%2C%20I%20would%20like%20to%20customize%20a%20catering%20menu%20for%20my%20event." target="_blank" rel="noopener" class="gjm-banner-btn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.476-.15-.677.15-.201.3-.777.978-.952 1.179-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.497-.896-.799-1.501-1.787-1.677-2.088-.175-.301-.019-.464.132-.614.136-.135.301-.351.451-.527.151-.176.201-.301.302-.502.101-.2.05-.376-.025-.526-.075-.15-.677-1.633-.928-2.235-.245-.587-.494-.507-.677-.517-.176-.01-.376-.01-.577-.01-.201 0-.526.075-.802.376-.276.301-1.053 1.029-1.053 2.511s1.078 2.912 1.229 3.113c.15.2 2.121 3.239 5.139 4.542.718.31 1.279.495 1.716.634.721.229 1.377.197 1.896.119.579-.087 1.78-.727 2.031-1.429.251-.702.251-1.303.176-1.429-.076-.125-.276-.201-.577-.351zM12.04 2c-5.522 0-10 4.477-10 10 0 1.765.459 3.424 1.261 4.871L2 22l5.281-1.385A9.957 9.957 0 0 0 12.04 22c5.522 0 10-4.478 10-10s-4.478-10-10-10zm0 18.273c-1.564 0-3.023-.424-4.283-1.162l-.307-.182-3.178.833.848-3.097-.2-.318A8.232 8.232 0 0 1 3.766 12c0-4.562 3.712-8.273 8.274-8.273 4.562 0 8.273 3.711 8.273 8.273 0 4.562-3.711 8.273-8.273 8.273z"/></svg>
            Customize Your Menu on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>

</div>
