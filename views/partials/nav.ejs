<%- include('preloader') %>

<header class="navbar">
  <div class="container">
    <a href="/" class="brand">
      <img src="<%= settings.logoImage %>" alt="<%= settings.businessName %> Logo" class="brand-logo">
      <span class="brand-text"><strong><%= settings.businessName %></strong><span><%= settings.tagline %></span></span>
    </a>
    <nav class="nav-links">
      <a href="/" class="<%= page==='home'?'active':'' %>">Home</a>
      <a href="/about" class="<%= page==='about'?'active':'' %>">About</a>
      <a href="/services" class="<%= page==='services'?'active':'' %>">Services</a>
      <a href="/menu" class="<%= page==='menu'?'active':'' %>">Menu</a>
      <a href="/gallery" class="<%= page==='gallery'?'active':'' %>">Gallery</a>
      <a href="/contact" class="<%= page==='contact'?'active':'' %>">Contact</a>
    </nav>
    <div class="nav-cta">
      <a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener" class="btn btn--whatsapp btn--sm">
        <svg viewBox="0 0 32 32" width="18" height="18" fill="currentColor">
          <path d="M16 2a13.9 13.9 0 0 0-12 21L2 30l7.2-1.9A13.9 13.9 0 1 0 16 2zm0 25.5c-2.3 0-4.6-.6-6.6-1.8l-.5-.3-4.9 1.3 1.3-4.7-.3-.5A11.5 11.5 0 1 1 16 27.5z"/>
          <path d="M21.5 18.8c-.3-.2-1.8-.9-2-.9-.3-.1-.5-.2-.7.2s-.8 1-1 1.2c-.2.2-.4.2-.7.1a8.6 8.6 0 0 1-2.6-1.6 9.4 9.4 0 0 1-1.8-2.3c-.2-.3 0-.5.1-.7.1-.1.3-.4.5-.5.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.1 1.1-1.1 2.6 1.1 3 1.3 3.2c.1.2 2.2 3.4 5.3 4.7.7.3 1.3.5 1.8.7.7.2 1.4.2 2 .1.6-.1 1.8-.7 2.1-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.6-.5z"/>
        </svg>
        WhatsApp
      </a>
      <button class="nav-toggle" aria-label="Open menu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<div class="mobile-overlay"></div>
<div class="mobile-panel">
  <button class="mobile-close" aria-label="Close menu">&times;</button>
  <a href="/">Home</a>
  <a href="/about">About</a>
  <a href="/services">Services</a>
  <a href="/menu">Menu</a>
  <a href="/gallery">Gallery</a>
  <a href="/contact">Contact</a>
</div>
