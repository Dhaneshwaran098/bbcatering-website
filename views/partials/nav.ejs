<%- include('preloader') %>

<header class="navbar">
  <div class="container">
    <a href="/" class="brand">
      <img src="<%= settings.logoImage %>" alt="<%= settings.businessName %> Logo" class="brand-logo">
      <div class="brand-text">
        <strong class="brand-title"><%= settings.businessName %></strong>
        <span class="brand-quote"><%= settings.tagline %></span>
      </div>
    </a>
    <nav class="nav-links">
      <a href="/" class="<%= page==='home'?'active':'' %>">Home</a>
      <a href="/about" class="<%= page==='about'?'active':'' %>">About</a>
      <a href="/services" class="<%= page==='services'?'active':'' %>">Services</a>
      <a href="/menu" class="<%= page==='menu'?'active':'' %>">Menu</a>
      <a href="/gallery" class="<%= page==='gallery'?'active':'' %>">Gallery</a>
      <a href="/contact" class="<%= page==='contact'?'active':'' %>">Contact</a>
    </nav>
    <button class="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="bar bar-top"></span>
      <span class="bar bar-mid"></span>
      <span class="bar bar-bot"></span>
    </button>
  </div>
</header>

<div class="mobile-overlay" aria-hidden="true"></div>
<div class="mobile-panel" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
  <div class="mobile-panel-header">
    <div class="brand">
      <img src="<%= settings.logoImage %>" alt="<%= settings.businessName %>" class="brand-logo" style="width:38px;height:38px;">
      <div class="brand-text">
        <strong class="brand-title" style="font-size:17px;"><%= settings.businessName %></strong>
        <span class="brand-quote" style="font-size:11.5px;"><%= settings.tagline %></span>
      </div>
    </div>
    <button class="mobile-close" aria-label="Close navigation menu">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <nav class="mobile-nav-links">
    <a href="/" class="<%= page==='home'?'active':'' %>">Home</a>
    <a href="/about" class="<%= page==='about'?'active':'' %>">About</a>
    <a href="/services" class="<%= page==='services'?'active':'' %>">Services</a>
    <a href="/menu" class="<%= page==='menu'?'active':'' %>">Menu</a>
    <a href="/gallery" class="<%= page==='gallery'?'active':'' %>">Gallery</a>
    <a href="/contact" class="<%= page==='contact'?'active':'' %>">Contact</a>
  </nav>

  <div class="mobile-panel-footer">
    <p class="drawer-address">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <span><%= settings.address %></span>
    </p>
    <div class="drawer-socials">
      <a href="<%= settings.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
      <a href="<%= settings.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 9h3V6h-3a3 3 0 0 0-3 3v2H8v3h3v6h3v-6h3l1-3h-4V9a1 1 0 0 1 1-1Z"/></svg></a>
      <a href="<%= settings.youtube %>" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="6" width="20" height="12" rx="3"/><path d="m10 9 5 3-5 3V9Z"/></svg></a>
    </div>
  </div>
</div>
