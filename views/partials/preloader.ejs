<!-- ============ LUXURY PRELOADER ============ -->
<div class="preloader" id="sitePreloader" aria-hidden="true">
  <div class="preloader-backdrop">
    <div class="preloader-ambient-glow"></div>
  </div>
  <div class="preloader-content">
    <div class="preloader-emblem">
      <div class="preloader-orbit-ring preloader-orbit-ring--outer"></div>
      <div class="preloader-orbit-ring preloader-orbit-ring--inner">
        <span class="preloader-sparkle"></span>
      </div>
      <div class="preloader-logo-frame">
        <img src="<%= settings.logoImage %>" alt="<%= settings.businessName %>" class="preloader-logo">
      </div>
    </div>
    <div class="preloader-brand-wrap">
      <h2 class="preloader-title"><%= settings.businessName %></h2>
      <p class="preloader-subtitle"><%= settings.tagline %></p>
    </div>
    <div class="preloader-progress-track">
      <div class="preloader-progress-bar"></div>
    </div>
  </div>
</div>
