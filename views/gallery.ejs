<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Gallery', description: 'Signature dishes, catering events, food preparation and wedding functions catered by us — browse our gallery.' }) %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-header">
  <div class="hero-bg"><div class="ph-photo" style="height:100%;background-image:url('/images/hero-feast.jpg')"></div></div>
  <div class="hero-scrim"></div>
  <div class="container">
    <div class="eyebrow">Gallery</div>
    <h1>A Taste of What We've Served</h1>
    <p class="crumbs"><a href="/">Home</a> / Gallery</p>
    <p class="lead">Signature dishes, live cooking, catering setups and functions we've had the pleasure of feeding. Tap any photo for a closer look.</p>
  </div>
</section>

<!-- ============ MARQUEE TICKER ============ -->
<div class="marquee">
  <div class="marquee-track">
    <span class="marquee-item">Wedding Catering</span><span class="marquee-item">Corporate Events</span><span class="marquee-item">Birthday &amp; Private Parties</span><span class="marquee-item">Custom Menus</span><span class="marquee-item">Live Counters</span><span class="marquee-item">Bulk Food Orders</span>
    <span class="marquee-item">Wedding Catering</span><span class="marquee-item">Corporate Events</span><span class="marquee-item">Birthday &amp; Private Parties</span><span class="marquee-item">Custom Menus</span><span class="marquee-item">Live Counters</span><span class="marquee-item">Bulk Food Orders</span>
  </div>
</div>

<section class="section">
  <div class="container">

    <% if (gallery.length === 0) { %>
      <p class="text-center" style="color:var(--ink-soft);">Photos are being added soon — check back shortly!</p>
    <% } else { %>

    <div class="g-filters" data-reveal="fade">
      <button class="g-filter active" data-filter="all">All</button>
      <button class="g-filter" data-filter="dishes">Signature Dishes</button>
      <button class="g-filter" data-filter="prep">Food Preparation</button>
      <button class="g-filter" data-filter="events">Catering Events</button>
      <button class="g-filter" data-filter="setups">Catering Setups</button>
    </div>

    <div class="masonry" data-reveal="fade">
      <% gallery.forEach(g => { %>
      <div class="g-item" data-category="<%= g.category %>" data-caption="<%= g.caption %>" style="height:<%= 210 + (g.id.length * 13) % 90 %>px;">
        <div class="ph-photo" style="height:100%;background-image:url('<%= g.image %>')"></div>
        <div class="g-overlay"><span><%= g.caption %></span></div>
        <div class="g-overlay"><span class="zoom-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg></span></div>
      </div>
      <% }) %>
    </div>

    <% } %>
  </div>
</section>

<!-- ============ LIVE ACTION & VIDEO REELS ============ -->
<% if (typeof videos !== 'undefined' && videos && videos.length > 0) { %>
<section class="section section--brown" data-reveal="fade">
  <div class="container">
    <div class="section-head center">
      <div class="eyebrow">Behind The Scenes</div>
      <h2>Live Action &amp; Kitchen Reels</h2>
      <p>Watch our master chefs in action — from live iron-tawa parotta making to grand handi biriyani mixing and hygienic meal packaging.</p>
    </div>

    <div class="video-reels-grid">
      <% videos.forEach(v => { %>
      <div class="video-card" data-video="<%= v.videoUrl %>" data-title="<%= v.title %>" data-desc="<%= v.description %>" data-reveal="fade">
        <div class="video-thumb-wrap">
          <video class="video-reel-player" src="<%= v.videoUrl %>" poster="<%= v.posterUrl %>" autoplay loop muted playsinline preload="auto"></video>
          <div class="video-scrim"></div>
          <button class="video-sound-toggle" aria-label="Toggle sound" title="Toggle audio">
            <svg class="icon-muted" viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
            <svg class="icon-unmuted" style="display:none;" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
          </button>
          <div class="live-badge"><span class="dot"></span> Live Reel</div>
          <div class="video-info">
            <span class="video-tag"><%= v.category.replace('-', ' ') %></span>
            <h3><%= v.title %></h3>
            <p><%= v.description %></p>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section--tight">
  <div class="container">
    <div class="cta-banner" data-reveal="scale">
      <div>
        <h2>Liked what you saw?</h2>
        <p>Let's plan the same warmth and flavour for your celebration.</p>
      </div>
      <div class="cta-actions">
        <a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener" class="btn btn--gold">Enquire Now</a>
        <a href="/services" class="btn btn--outline">View Services</a>
      </div>
    </div>
  </div>
</section>

<!-- Photo Lightbox -->
<div class="lightbox">
  <button class="lightbox-close" aria-label="Close">&times;</button>
  <div class="lightbox-inner">
    <div class="ph-photo"></div>
    <div class="lightbox-caption"></div>
  </div>
</div>

<!-- Video Lightbox Player Modal -->
<div class="video-lightbox">
  <div class="video-lightbox-container">
    <button class="video-lightbox-close" aria-label="Close video player">&times;</button>
    <div class="video-player-frame">
      <video controls playsinline preload="metadata"></video>
    </div>
    <div class="video-lightbox-caption">
      <h4></h4>
      <p></p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
</body>
</html>
