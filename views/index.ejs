<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Home', description: 'BB Catering provides thoughtful wedding, corporate and private-event catering with flexible menus and dependable service across Chennai.' }) %>
</head>
<body>
<%- include('partials/nav') %>

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero-bg">
    <div class="ph-photo" style="background-image:url('<%= settings.heroImage %>')"></div>
  </div>
  <div class="hero-scrim"></div>
  <div class="container hero-content">
    <div class="hero-eyebrow"><span class="dot">BB</span> <%= settings.businessName %> &middot; Catering for every celebration</div>
    <h1>Food That Brings<br><em>People Together.</em></h1>
    <p class="hero-tagline">Freshly prepared menus, attentive service and flexible catering plans for weddings, corporate events and private celebrations.</p>
    <div class="hero-actions">
      <a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener" class="btn btn--primary">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.476-.15-.677.15-.201.3-.777.978-.952 1.179-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.497-.896-.799-1.501-1.787-1.677-2.088-.175-.301-.019-.464.132-.614.136-.135.301-.351.451-.527.151-.176.201-.301.302-.502.101-.2.05-.376-.025-.526-.075-.15-.677-1.633-.928-2.235-.245-.587-.494-.507-.677-.517-.176-.01-.376-.01-.577-.01-.201 0-.526.075-.802.376-.276.301-1.053 1.029-1.053 2.511s1.078 2.912 1.229 3.113c.15.2 2.121 3.239 5.139 4.542.718.31 1.279.495 1.716.634.721.229 1.377.197 1.896.119.579-.087 1.78-.727 2.031-1.429.251-.702.251-1.303.176-1.429-.076-.125-.276-.201-.577-.351zM12.04 2c-5.522 0-10 4.477-10 10 0 1.765.459 3.424 1.261 4.871L2 22l5.281-1.385A9.957 9.957 0 0 0 12.04 22c5.522 0 10-4.478 10-10s-4.478-10-10-10zm0 18.273c-1.564 0-3.023-.424-4.283-1.162l-.307-.182-3.178.833.848-3.097-.2-.318A8.232 8.232 0 0 1 3.766 12c0-4.562 3.712-8.273 8.274-8.273 4.562 0 8.273 3.711 8.273 8.273 0 4.562-3.711 8.273-8.273 8.273z"/></svg>
        Enquire on WhatsApp
      </a>
      <a href="/services" class="btn btn--outline">Explore Our Services
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="hero-stats">
      <div class="stat"><b data-count="7" data-suffix="+">0</b><span>Years of Excellence</span></div>
      <div class="stat"><b data-count="1200" data-suffix="+">0</b><span>Events Catered</span></div>
      <div class="stat"><b data-count="45" data-suffix="+">0</b><span>Menu Choices</span></div>
    </div>
  </div>
  <div class="scroll-cue"><span>Scroll</span><span class="line"></span></div>
</section>

<!-- ============ MARQUEE TICKER ============ -->
<div class="marquee">
  <div class="marquee-track">
    <span class="marquee-item">Wedding Catering</span><span class="marquee-item">Corporate Events</span><span class="marquee-item">Birthday &amp; Private Parties</span><span class="marquee-item">Custom Menus</span><span class="marquee-item">Live Counters</span><span class="marquee-item">Bulk Food Orders</span>
    <span class="marquee-item">Wedding Catering</span><span class="marquee-item">Corporate Events</span><span class="marquee-item">Birthday &amp; Private Parties</span><span class="marquee-item">Custom Menus</span><span class="marquee-item">Live Counters</span><span class="marquee-item">Bulk Food Orders</span>
  </div>
</div>

<!-- ============ INTRO ============ -->
<section class="section">
  <div class="container split">
    <div class="split-media" data-reveal="left">
      <div class="frame"><div class="ph-photo" style="background-image:url('https://images.unsplash.com/photo-1589302168068-964664d93dc0?auto=format&fit=crop&w=900&q=80')"></div></div>
      <div class="accent-ring"></div>
      <div class="frame-badge"><b>7+ Yrs</b><span>Creating well-planned meals for important occasions</span></div>
    </div>
    <div class="split-body" data-reveal="right">
      <div class="eyebrow">Who We Are</div>
      <h2>Complete Catering for Meaningful Occasions</h2>
      <p>BB Catering helps hosts serve a meal they can feel proud of. We plan menus around your guests, occasion and budget, then handle preparation, delivery and service with care. From family celebrations to large-format events, our focus is simple: fresh food, smooth coordination and a satisfying experience for every guest.</p>
      <a href="/about" class="card-link" style="margin-top:22px;">Read our story
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<div class="divider-strip"><div class="kolam-divider" style="width:220px;"></div></div>

<!-- ============ WHY CHOOSE US ============ -->
<section class="section section--red" data-reveal="fade">
  <div class="kolam-bg"></div>
  <div class="container">
    <div class="section-head center">
      <div class="eyebrow">Why Choose Us</div>
      <h2>A Better Way to Cater Every Event</h2>
      <p>Clear planning and thoughtful food service make hosting easier from the first enquiry to the final plate.</p>
    </div>
    <div class="why-grid" data-stagger>
      <div class="why-item" data-reveal="fade">
        <span class="num">01</span>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 3v6a3 3 0 0 0 3 3v9M17 3c-2 0-3 3-3 6s1 4 3 4v8"/></svg></div>
        <h3>Quality Ingredients</h3>
        <p>Carefully sourced ingredients and fresh preparation for a meal your guests will enjoy.</p>
      </div>
      <div class="why-item" data-reveal="fade">
        <span class="num">02</span>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2 4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-4Z"/><path d="m9 12 2 2 4-4"/></svg></div>
        <h3>Flexible Menus</h3>
        <p>Menu combinations and portion planning shaped around your event, guests and budget.</p>
      </div>
      <div class="why-item" data-reveal="fade">
        <span class="num">03</span>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"/></svg></div>
        <h3>Experienced Planning</h3>
        <p>Practical support for menu selection, service flow, staffing and event-day requirements.</p>
      </div>
      <div class="why-item" data-reveal="fade">
        <span class="num">04</span>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="8" width="14" height="9" rx="1.5"/><path d="M16 11h3.2a1 1 0 0 1 .9.55L22 15v2h-6"/><circle cx="7" cy="19" r="1.6"/><circle cx="18" cy="19" r="1.6"/></svg></div>
        <h3>Professional Service</h3>
        <p>Prompt delivery, organised service and a courteous team from setup through completion.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ POPULAR DISHES PREVIEW (live from admin) ============ -->
<section class="section">
  <div class="container">
    <div class="section-head center">
      <div class="eyebrow">Our Menu</div>
      <h2>Popular Choices for Every Gathering</h2>
      <p>Explore a selection of dishes that can be included in a menu tailored to your occasion.</p>
    </div>
    <div class="grid grid--4" data-stagger>
      <% popularDishes.forEach(dish => { %>
      <div class="card dish-card" data-reveal="scale">
        <div class="card-media"><div class="ph-photo" style="background-image:url('<%= dish.image %>')"></div><span class="card-tag"><%= dish.category %></span></div>
        <div class="card-body">
          <div>
            <h4><%= dish.name %></h4>
            <div class="spice">
              <% for (let i=0;i<4;i++) { %><span class="<%= i < dish.spice ? 'on' : '' %>"></span><% } %>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="text-center" style="margin-top:44px;">
      <a href="/menu" class="btn btn--dark-outline">See Full Menu
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ============ SERVICES PREVIEW ============ -->
<section class="section section--brown" data-reveal="fade">
  <div class="container">
    <div class="section-head center">
      <div class="eyebrow">Catering For Every Occasion</div>
      <h2>Catering Built Around Your Event</h2>
      <p>From weddings and corporate events to birthdays and private gatherings, we build each service around your plans.</p>
    </div>
    <div class="grid grid--3" data-stagger>
      <div class="card" data-reveal="fade">
        <div class="card-media"><div class="ph-photo" style="background-image:url('https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=700&q=80')"></div><span class="card-tag">Weddings</span></div>
        <div class="card-body">
          <h3>Wedding Catering</h3>
          <p>Well-organised wedding menus and service plans for celebrations of every size.</p>
          <a href="/services" class="card-link">Learn more <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
      <div class="card" data-reveal="fade">
        <div class="card-media"><div class="ph-photo" style="background-image:url('https://images.unsplash.com/photo-1617692855027-33b14f061079?auto=format&fit=crop&w=700&q=80')"></div><span class="card-tag">Family Functions</span></div>
        <div class="card-body">
          <h3>Engagement &amp; Family Functions</h3>
          <p>Comforting, crowd-pleasing menus for engagements, housewarmings and family gatherings.</p>
          <a href="/services" class="card-link">Learn more <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
      <div class="card" data-reveal="fade">
        <div class="card-media"><div class="ph-photo" style="background-image:url('https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=700&q=80')"></div><span class="card-tag">Corporate</span></div>
        <div class="card-body">
          <h3>Corporate Events</h3>
          <p>Well-timed, professionally served menus for offices, launches and corporate celebrations.</p>
          <a href="/services" class="card-link">Learn more <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
    </div>
    <div class="text-center" style="margin-top:44px;">
      <a href="/services" class="btn btn--gold">View All Services</a>
    </div>
  </div>
</section>

<!-- ============ GALLERY PREVIEW (live from admin) ============ -->
<section class="section">
  <div class="container">
    <div class="section-head center">
      <div class="eyebrow">A Taste, In Pictures</div>
      <h2>From Our Kitchen to Your Function</h2>
    </div>
    <div class="masonry">
      <% galleryPreview.forEach(g => { %>
      <div class="g-item" style="height:230px;"><div class="ph-photo" style="height:100%;background-image:url('<%= g.image %>')"></div></div>
      <% }) %>
    </div>
    <div class="text-center" style="margin-top:36px;">
      <a href="/gallery" class="btn btn--dark-outline">View Full Gallery
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section--tight">
  <div class="container">
    <div class="section-head center" data-reveal="fade">
      <div class="eyebrow">Kind Words</div>
      <h2>What Our Guests Say</h2>
    </div>
    <div class="t-carousel" data-reveal="fade">
      <div class="t-slide active">
        <div class="mark">&ldquo;</div>
        <p>The mutton kuzhambu tasted exactly like my grandmother's cooking in Madurai. Our wedding guests are still talking about it.</p>
        <div class="who">— A Recent Wedding Client, Madurai</div>
      </div>
      <div class="t-slide">
        <div class="mark">&ldquo;</div>
        <p>We booked them for our office annual day and the chicken chettinad was the highlight of the whole event. On time, professional, and genuinely tasty.</p>
        <div class="who">— Corporate Event Organiser, Madurai</div>
      </div>
      <div class="t-slide">
        <div class="mark">&ldquo;</div>
        <p>Ordered a bulk parcel for a temple function — 500 plates, every single one hot and fresh. That kind of consistency is rare.</p>
        <div class="who">— Community Function Host</div>
      </div>
      <div class="t-dots"></div>
    </div>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="section--tight">
  <div class="container">
    <div class="cta-banner" data-reveal="scale">
      <div>
        <h2>Planning an event? Let's talk food.</h2>
      <p>Share your date, guest count and occasion, and our team will help shape the right catering plan.</p>
      </div>
      <div class="cta-actions">
        <a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener" class="btn btn--gold">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.476-.15-.677.15-.201.3-.777.978-.952 1.179-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.497-.896-.799-1.501-1.787-1.677-2.088-.175-.301-.019-.464.132-.614.136-.135.301-.351.451-.527.151-.176.201-.301.302-.502.101-.2.05-.376-.025-.526-.075-.15-.677-1.633-.928-2.235-.245-.587-.494-.507-.677-.517-.176-.01-.376-.01-.577-.01-.201 0-.526.075-.802.376-.276.301-1.053 1.029-1.053 2.511s1.078 2.912 1.229 3.113c.15.2 2.121 3.239 5.139 4.542.718.31 1.279.495 1.716.634.721.229 1.377.197 1.896.119.579-.087 1.78-.727 2.031-1.429.251-.702.251-1.303.176-1.429-.076-.125-.276-.201-.577-.351zM12.04 2c-5.522 0-10 4.477-10 10 0 1.765.459 3.424 1.261 4.871L2 22l5.281-1.385A9.957 9.957 0 0 0 12.04 22c5.522 0 10-4.478 10-10s-4.478-10-10-10zm0 18.273c-1.564 0-3.023-.424-4.283-1.162l-.307-.182-3.178.833.848-3.097-.2-.318A8.232 8.232 0 0 1 3.766 12c0-4.562 3.712-8.273 8.274-8.273 4.562 0 8.273 3.711 8.273 8.273 0 4.562-3.711 8.273-8.273 8.273z"/></svg>
          Enquire Now
        </a>
        <a href="/contact" class="btn btn--outline">Contact Page</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
