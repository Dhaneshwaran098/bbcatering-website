<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Catering & Services', description: 'Wedding catering, corporate events, birthdays, private parties, cultural functions and bulk food orders planned around your needs.' }) %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-header">
  <div class="hero-bg"><div class="ph-photo" style="height:100%;background-image:url('https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&w=1800&q=80')"></div></div>
  <div class="hero-scrim"></div>
  <div class="container">
    <div class="eyebrow">Catering &amp; Services</div>
    <h1>Catering Built Around Your Occasion</h1>
    <p class="crumbs"><a href="/">Home</a> / Services</p>
    <p class="lead">From an intimate family lunch to a large wedding, we plan the menu, prepare fresh food and serve on time.</p>
  </div>
</section>

<!-- ============ MARQUEE TICKER ============ -->
<div class="marquee">
  <div class="marquee-track">
    <span class="marquee-item">Wedding Catering</span><span class="marquee-item">Corporate Events</span><span class="marquee-item">Birthday &amp; Private Parties</span><span class="marquee-item">Custom Menus</span><span class="marquee-item">Live Counters</span><span class="marquee-item">Bulk Food Orders</span>
    <span class="marquee-item">Wedding Catering</span><span class="marquee-item">Corporate Events</span><span class="marquee-item">Birthday &amp; Private Parties</span><span class="marquee-item">Custom Menus</span><span class="marquee-item">Live Counters</span><span class="marquee-item">Bulk Food Orders</span>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="grid grid--3" data-stagger>
      <div class="card" data-reveal="fade">
        <div class="card-media"><div class="ph-photo" style="background-image:url('https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=700&q=80')"></div><span class="card-tag">Weddings</span></div>
        <div class="card-body"><h3>Wedding Catering</h3><p>Curated wedding menus, buffet planning and coordinated service for celebrations of every size.</p></div>
      </div>
      <div class="card" data-reveal="fade">
        <div class="card-media"><div class="ph-photo" style="background-image:url('https://images.unsplash.com/photo-1617692855027-33b14f061079?auto=format&fit=crop&w=700&q=80')"></div><span class="card-tag">Family Functions</span></div>
        <div class="card-body"><h3>Engagement &amp; Family Functions</h3><p>Warm, home-style spreads for engagements, housewarmings, naming ceremonies and other family milestones.</p></div>
      </div>
      <div class="card" data-reveal="fade">
        <div class="card-media"><div class="ph-photo" style="background-image:url('https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=700&q=80')"></div><span class="card-tag">Private Events</span></div>
        <div class="card-body"><h3>Birthday &amp; Private Events</h3><p>Custom menus and optional live counters for birthdays, get-togethers and private celebrations.</p></div>
      </div>
      <div class="card" data-reveal="fade">
        <div class="card-media"><div class="ph-photo" style="background-image:url('https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=700&q=80')"></div><span class="card-tag">Corporate</span></div>
        <div class="card-body"><h3>Corporate Events</h3><p>On-time, professionally served menus for office parties, product launches, conferences and client meets.</p></div>
      </div>
      <div class="card" data-reveal="fade">
        <div class="card-media"><div class="ph-photo" style="background-image:url('https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?auto=format&fit=crop&w=700&q=80')"></div><span class="card-tag">Cultural</span></div>
        <div class="card-body"><h3>Traditional &amp; Cultural Functions</h3><p>Thoughtfully planned food service for community gatherings, cultural programmes and special occasions.</p></div>
      </div>
      <div class="card" data-reveal="fade">
        <div class="card-media"><div class="ph-photo" style="background-image:url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=700&q=80')"></div><span class="card-tag">Bulk Orders</span></div>
        <div class="card-body"><h3>Bulk Food Orders</h3><p>Large-quantity packed meals and parcels for institutions, teams, camps and event organisers.</p></div>
      </div>
    </div>
  </div>
</section>

<div class="divider-strip"><div class="kolam-divider" style="width:220px;"></div></div>

<section class="section section--red" data-reveal="fade">
  <div class="kolam-bg"></div>
  <div class="container">
    <div class="section-head center">
      <div class="eyebrow">How It Works</div>
      <h2>Booking Your Catering Is Simple</h2>
    </div>
    <div class="why-grid" data-stagger>
      <div class="why-item" data-reveal="fade"><span class="num">01</span><h3>Share Your Event</h3><p>Tell us the date, guest count and occasion over WhatsApp or a quick call.</p></div>
      <div class="why-item" data-reveal="fade"><span class="num">02</span><h3>Pick Your Menu</h3><p>We suggest dishes and combos based on your budget and occasion.</p></div>
      <div class="why-item" data-reveal="fade"><span class="num">03</span><h3>We Confirm &amp; Plan</h3><p>Quantities, staff and logistics are locked in ahead of your date.</p></div>
      <div class="why-item" data-reveal="fade"><span class="num">04</span><h3>Fresh, On-Time Service</h3><p>Our team cooks fresh on-site or delivers hot, right on schedule.</p></div>
    </div>
  </div>
</section>

<section class="section--tight">
  <div class="container">
    <div class="cta-banner" data-reveal="scale">
      <div>
        <h2>Not sure which service fits your event?</h2>
        <p>Send us your event details on WhatsApp and we'll recommend the right catering package.</p>
      </div>
      <div class="cta-actions">
        <a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener" class="btn btn--gold">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.476-.15-.677.15-.201.3-.777.978-.952 1.179-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.497-.896-.799-1.501-1.787-1.677-2.088-.175-.301-.019-.464.132-.614.136-.135.301-.351.451-.527.151-.176.201-.301.302-.502.101-.2.05-.376-.025-.526-.075-.15-.677-1.633-.928-2.235-.245-.587-.494-.507-.677-.517-.176-.01-.376-.01-.577-.01-.201 0-.526.075-.802.376-.276.301-1.053 1.029-1.053 2.511s1.078 2.912 1.229 3.113c.15.2 2.121 3.239 5.139 4.542.718.31 1.279.495 1.716.634.721.229 1.377.197 1.896.119.579-.087 1.78-.727 2.031-1.429.251-.702.251-1.303.176-1.429-.076-.125-.276-.201-.577-.351zM12.04 2c-5.522 0-10 4.477-10 10 0 1.765.459 3.424 1.261 4.871L2 22l5.281-1.385A9.957 9.957 0 0 0 12.04 22c5.522 0 10-4.478 10-10s-4.478-10-10-10zm0 18.273c-1.564 0-3.023-.424-4.283-1.162l-.307-.182-3.178.833.848-3.097-.2-.318A8.232 8.232 0 0 1 3.766 12c0-4.562 3.712-8.273 8.274-8.273 4.562 0 8.273 3.711 8.273 8.273 0 4.562-3.711 8.273-8.273 8.273z"/></svg>
          Enquire on WhatsApp
        </a>
        <a href="/menu" class="btn btn--outline">See Our Menu</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
